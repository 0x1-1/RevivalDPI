<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        KOYU TEMA: semantic token'lar.

        Light.xaml ile BİREBİR AYNI anahtar kümesini tanımlamak zorundadır.
        Bir anahtar burada eksikse, tema koyuya geçtiğinde o kontrol açık tema
        değerinde kalır ve karışık tema oluşur, spesifikasyonun açıkça
        yasakladığı durum. Anahtar eşleşmesi ThemeManager tarafından hata
        ayıklama derlemelerinde doğrulanır.
    -->

    <!-- ===== Color katmanı ===== -->
    <Color x:Key="Color.Background">#FF1C1E20</Color>
    <Color x:Key="Color.Surface">#FF242628</Color>
    <Color x:Key="Color.SurfaceRaised">#FF2B2E31</Color>
    <Color x:Key="Color.Border">#FF383C40</Color>
    <Color x:Key="Color.BorderStrong">#FF4A4F54</Color>
    <Color x:Key="Color.TextPrimary">#FFE7E9EB</Color>
    <Color x:Key="Color.TextSecondary">#FFA0A6AC</Color>
    <Color x:Key="Color.Accent">#FF7FA5C9</Color>
    <Color x:Key="Color.AccentStrong">#FF5980A6</Color>
    <Color x:Key="Color.OnAccent">#FF131F2B</Color>
    <Color x:Key="Color.Success">#FF6CBB8D</Color>
    <Color x:Key="Color.Warning">#FFD3A34A</Color>
    <Color x:Key="Color.Danger">#FFE0837B</Color>
    <Color x:Key="Color.DangerStrong">#FFC8544A</Color>
    <Color x:Key="Color.Track">#FF4A4F54</Color>
    <!-- Hover tonu: beyaz %5 -->
    <Color x:Key="Color.Hover">#0DFFFFFF</Color>
    <!-- Dialog arkası scrim: siyah %45 (her iki temada aynı) -->
    <Color x:Key="Color.Overlay">#73000000</Color>
    <Color x:Key="Color.Focus">#FF7FA5C9</Color>
    <Color x:Key="Color.Shadow">#73000000</Color>

    <!-- ===== Brush katmanı ===== -->
    <SolidColorBrush x:Key="Brush.Background"     Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface"        Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised"  Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.Border"         Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong"   Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary"    Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary"  Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Accent"         Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentStrong"   Color="{StaticResource Color.AccentStrong}" />
    <SolidColorBrush x:Key="Brush.OnAccent"       Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Success"        Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning"        Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger"         Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerStrong"   Color="{StaticResource Color.DangerStrong}" />
    <SolidColorBrush x:Key="Brush.Track"          Color="{StaticResource Color.Track}" />
    <SolidColorBrush x:Key="Brush.Hover"          Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Overlay"        Color="{StaticResource Color.Overlay}" />
    <SolidColorBrush x:Key="Brush.Focus"          Color="{StaticResource Color.Focus}" />

    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib"
                   x:Key="Opacity.Disabled">0.45</system:Double>

    <!-- ===== Eski anahtar adları (geçiş dönemi) ===== -->
    <SolidColorBrush x:Key="AppBackgroundBrush"      Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="AppSurfaceBrush"         Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="AppBorderBrush"          Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="AppTextPrimaryBrush"     Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush"   Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="AppTextMutedBrush"       Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="AccentBrush"             Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="AccentForegroundBrush"   Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="AccentSoftBrush"         Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="DangerBrush"             Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush"      Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="SuccessBrush"            Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="WarningBrush"            Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="FocusRingBrush"          Color="{StaticResource Color.Focus}" />
    <SolidColorBrush x:Key="ControlTrackBrush"       Color="{StaticResource Color.Track}" />
    <SolidColorBrush x:Key="ControlHoverBrush"       Color="{StaticResource Color.Hover}" />

    <SolidColorBrush x:Key="MaterialDesignPaper"   Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="MaterialDesignBody"    Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="MaterialDesignDivider" Color="{StaticResource Color.Border}" />

</ResourceDictionary>
